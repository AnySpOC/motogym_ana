{
  "name": "motogym-ana-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:simulation && npm run test:recorded",
    "test:unit": "node tests/motion-model.test.mjs && node tests/speed-filters.test.mjs",
    "test:simulation": "node tests/automatic-timing.simulation.test.mjs",
    "test:robustness": "node tests/automatic-timing.robustness.test.mjs",
    "test:soak": "node tests/automatic-timing.robustness.test.mjs --trials 200 --seed 20261019 --summary-only --json docs/generated/ROBUSTNESS_SOAK_LATEST.json",
    "test:recorded": "node tests/recorded-log-regression.test.mjs",
    "release:gate": "node scripts/release_gate.mjs",
    "analyze:gopro": "node scripts/analyze_gopro_mp4.mjs",
    "analyze:video": "node scripts/analyze_video_motion.mjs",
    "evaluate:existing": "node scripts/evaluate_existing_runs.mjs",
    "evaluate:filters": "node scripts/compare_speed_filters.mjs"
  },
  "dependencies": {
    "gopro-telemetry": "1.2.11",
    "gpmf-extract": "0.3.3"
  },
  "devDependencies": {
    "ffmpeg-static": "5.3.0"
  }
}
